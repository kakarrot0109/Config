# macOS
**/.DS_Store
._*
.Spotlight-V100
.Trashes

# 编辑器/IDE 缓存
.vscode/
.idea/
*.swp
*.swo

# 备份文件
*.bak
*.bak.md
*.bak.ghostty
*.backup
*~

# 临时文件
*.tmp
*.log

# 本地私有配置（不同步）
.claude/settings.local.json
.env
.env.local
*.pem
*.key

# Node（如果将来加了 build script）
node_modules/
dist/
__pycache__/
*.pyc

# 本地任务草稿（不入库）
/tasks/

# 只保留这些目录和文件
/*
!/themes/
!/tokens/
!/scripts/
!/img/
!/LICENSE
!/markdown-showcase.md
!/README.md
!/README.zh-CN.md
!/AGENTS.md
!/CLAUDE.md
!/.gitignore

# 白名单解开目录后，仍递归排除 Finder 元数据
**/.DS_Store

# Agent 本地任务与规格（不入库）
tasks/

# 客户端截图原图可能包含本地侧栏、路径或账号信息，仅保留裁切后的公开图
img/screenshots/raw/
