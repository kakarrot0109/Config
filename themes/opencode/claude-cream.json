    "diffHighlightRemoved": { "dark": "dark-error", "light": "light-error" },
    "diffAddedBg": { "dark": "dark-diff-added-bg", "light": "light-diff-added-bg" },
    "diffRemovedBg": { "dark": "dark-diff-removed-bg", "light": "light-diff-removed-bg" },
    "diffContextBg": { "dark": "dark-surface-inset", "light": "light-surface-inset" },
    "diffLineNumber": { "dark": "dark-muted-soft", "light": "light-muted-soft" },
    "diffAddedLineNumberBg": { "dark": "dark-diff-added-bg", "light": "light-diff-added-bg" },
    "diffRemovedLineNumberBg": { "dark": "dark-diff-removed-bg", "light": "light-diff-removed-bg" },
    "markdownText": { "dark": "dark-body", "light": "light-body" },
    "markdownHeading": { "dark": "dark-primary", "light": "light-text-accent" },
    "markdownLink": { "dark": "dark-accent-teal", "light": "light-accent-teal" },
    "markdownLinkText": { "dark": "dark-primary", "light": "light-primary" },
    "markdownCode": { "dark": "dark-syn-string", "light": "light-syn-string" },
    "markdownBlockQuote": { "dark": "dark-muted", "light": "light-muted" },
    "markdownEmph": { "dark": "dark-syn-number", "light": "light-syn-number" },
    "markdownStrong": { "dark": "dark-primary-active", "light": "light-primary-active" },
    "markdownHorizontalRule": { "dark": "dark-hairline", "light": "light-hairline" },
    "markdownListItem": { "dark": "dark-primary", "light": "light-primary" },
    "markdownListEnumeration": { "dark": "dark-accent-teal", "light": "light-accent-teal" },
    "markdownImage": { "dark": "dark-accent-teal", "light": "light-accent-teal" },
    "markdownImageText": { "dark": "dark-primary", "light": "light-primary" },
    "markdownCodeBlock": { "dark": "dark-ink", "light": "light-ink" },
    "syntaxComment": { "dark": "dark-syn-comment", "light": "light-syn-comment" },
    "syntaxKeyword": { "dark": "dark-syn-keyword", "light": "light-syn-keyword" },
    "syntaxFunction": { "dark": "dark-syn-function", "light": "light-syn-function" },
    "syntaxVariable": { "dark": "dark-syn-variable", "light": "light-syn-variable" },
    "syntaxString": { "dark": "dark-syn-string", "light": "light-syn-string" },
    "syntaxNumber": { "dark": "dark-syn-number", "light": "light-syn-number" },
    "syntaxType": { "dark": "dark-syn-type", "light": "light-syn-type" },
    "syntaxOperator": { "dark": "dark-syn-operator", "light": "light-syn-operator" },
    "syntaxPunctuation": { "dark": "dark-syn-punctuation", "light": "light-syn-punctuation" }
