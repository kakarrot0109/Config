  "theme": {
    "primary": { "dark": "dark-primary", "light": "light-primary" },
    "secondary": { "dark": "dark-accent-teal", "light": "light-accent-teal" },
    "accent": { "dark": "dark-primary-active", "light": "light-text-accent" },
    "error": { "dark": "dark-error", "light": "light-error" },
    "warning": { "dark": "dark-warning", "light": "light-warning" },
    "success": { "dark": "dark-success", "light": "light-success" },
    "info": { "dark": "dark-info", "light": "light-info" },
    "text": { "dark": "dark-body", "light": "light-body" },
    "textMuted": { "dark": "dark-muted", "light": "light-muted" },
    "selectedListItemText": { "dark": "dark-on-primary", "light": "light-on-primary" },
    "background": { "dark": "dark-canvas", "light": "light-surface-soft" },
